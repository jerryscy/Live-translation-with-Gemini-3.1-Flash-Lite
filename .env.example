# Required: your Google Cloud project ID.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region for Gemini 3.1 Flash Lite. "global" routes to the nearest endpoint.
GOOGLE_CLOUD_LOCATION=global

# Model IDs (override if Google releases new versions).
TRANSLATION_MODEL=gemini-3.1-flash-lite
TTS_MODEL=gemini-3.1-flash-tts-preview

# gemini-3.1-flash-tts-preview is only served from the global endpoint.
TTS_LOCATION=global

# Optional: bind address.
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# DeepFilterNet v3 background-noise suppression (optional)
# ---------------------------------------------------------------------------
# Set to 0/false to disable DFN3 entirely (the backend then falls back to a
# raw-audio RMS VAD with no denoising). Useful for benchmarking or for
# extremely clean-mic setups where DFN3 isn't worth its ~20–40 ms latency.
DEEPFILTERNET_ENABLED=1

# Max amount of noise attenuation DFN3 is allowed to apply, in dB. The
# upstream default is effectively unlimited (~100 dB), which can sometimes
# sound artificial and over-suppress quiet speech. 20–30 dB tends to give
# the best speech-recognition results for downstream ASR / Gemini.
DEEPFILTERNET_ATTEN_LIM_DB=30

